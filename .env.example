# FlashTech environment template.
# Copy this file to `.env` and replace the placeholder values.
# `.env` is git-ignored; this example file is committed with safe fakes only.
#
# SECURITY: a Supabase "publishable"/"anon" key is designed for browser use and
# is protected by Row Level Security. NEVER put a `service_role` key here or in
# any front-end code — it bypasses RLS and grants full database access.

# Public Supabase project settings (safe to ship to the browser).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional: CAPTCHA for public forms (contact / newsletter). Server-side only.
CAPTCHA_SITE_KEY=replace_me
CAPTCHA_SECRET_KEY=replace_me
